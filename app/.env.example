# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me
LOG_LEVEL=INFO
# Required in staging/production (comma-separated), e.g.
# CORS_ALLOWED_ORIGINS=https://rpg-horizon-radar-fe.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io
CORS_ALLOWED_ORIGINS=

# ── First user ───────────────────────────────────────────────────────────────
# Created on a start against a database where nobody can sign in; that user adds
# everyone else in Admin -> Users. Deployed: FIRST_USER_PASSWORD_KV_URI instead.
FIRST_USER_EMAIL=
FIRST_USER_NAME=First User
FIRST_USER_PASSWORD=

# ── Database / Cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rpg_horizon_radar
REDIS_URL=redis://localhost:6379/0

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Optional: a larger deployment the Acquisition Thesis agent tries first (e.g. gpt-5.6-luna).
AZURE_THESIS_DEPLOYMENT=

# ── Azure Key Vault (optional; set *_KV_URI to source secrets from KV) ────────
AZURE_KEYVAULT_URL=https://zaf-kv-01.vault.azure.net/
# AZURE_OPENAI_API_KEY_KV_URI=https://zaf-kv-01.vault.azure.net/secrets/azure-openai-api-key
# DATABASE_URL_KV_URI=
# REDIS_URL_KV_URI=

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=rpg-horizon-radar
TEMPORAL_TASK_QUEUE_AGENTS=rpg-horizon-radar-agents

# ── Arize Phoenix Observability ──────────────────────────────────────────────
# false locally / in CI if you don't run a Phoenix collector — skips the exporter outright
# instead of configuring one that retries forever in the background (noisy logs either way).
TRACING_ENABLED=true
PHOENIX_HOST=localhost
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=rpg-horizon-radar
# PHOENIX_COLLECTOR_ENDPOINT=https://zaf-phoenix.bravesky-d9f9eeb7.eastus2.azurecontainerapps.io/v1/traces
# ARIZE_PHOENIX_API_KEY=

# ── Live signal connectors (real, approved companies only) ───────────────────
# Each connector runs only when its key is set. See DESIGN.md §15 for quotas.
# Local dev without Docker: DATABASE_URL=sqlite+aiosqlite:///./horizon_radar.db
LIVE_CONNECTORS_ENABLED=true
GNEWS_API_KEY=
NEWSDATA_API_KEY=
TAVILY_API_KEY=                 # also used by watchlist discovery
YOUTUBE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
ALPHA_VANTAGE_API_KEY=          # 25 calls a day
FINCRUX_API_KEY=                # 5 calls a day
NSE_ENABLED=true                # no key; NSE's site API, two calls per company a day
# Deployed environments: set the matching *_KV_URI instead of the plain key above, e.g.
# GNEWS_API_KEY_KV_URI=https://zaf-kv-01.vault.azure.net/secrets/gnews-api-key — every
# connector key has one (see infra/aca-setup.sh). TODO.md §1: every key above was pasted into
# chat during the build and needs rotating before Key Vault is populated with the new values.

# ── Reasoning LLM (watchlist discovery + SWOT briefs; never scoring) ─────────
# Tried in order, then Azure OpenAI above as the last route.
GROQ_API_KEY=
NVIDIA_API_KEY=
# GROQ_API_KEY_KV_URI= / NVIDIA_API_KEY_KV_URI= — same Key Vault pattern as the connectors above.
LLM_ROUTES=groq:openai/gpt-oss-120b,nvidia:nvidia/nemotron-3-super-120b-a12b
LLM_REASONING_EFFORT=low

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
INGEST_DAILY_AT=17:00
DISCOVERY_EVERY_DAYS=7
SWOT_EVERY_DAYS=7
OPPORTUNITY_DAILY_AT=08:00
